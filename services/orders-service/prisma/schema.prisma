// This is your Prisma schema file
// https://www.prisma.io/docs/concepts/components/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enumeraciones ───────────────────────────────────────────────────────────

enum Role {
  ADMIN
  ATENCION
  COCINA
  CLIENTE
}

enum OrderStatus {
  RECIBIDO
  CONFIRMADO
  PREPARANDO
  LISTO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum DeliveryType {
  RECOJO
  DELIVERY
}

enum NotificationType {
  PEDIDO_CREADO
  PEDIDO_CONFIRMADO
  PEDIDO_EN_PREPARACION
  PEDIDO_LISTO
  PEDIDO_EN_CAMINO
  PEDIDO_ENTREGADO
  PEDIDO_CANCELADO
  SISTEMA
}

// ─── Tablas ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(CLIENTE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relaciones
  ordersAsCustomer    Order[]              @relation("CustomerOrders")
  ordersCreated       Order[]              @relation("CreatedByOrders")
  statusChanges       OrderStatusHistory[]
  notifications       Notification[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(500)
  active      Boolean   @default(true)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  products Product[]

  @@index([active])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(1000)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  price       Decimal  @db.Decimal(10, 2)
  available   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([available])
  @@index([name])
  @@map("products")
}

model Order {
  id           String       @id @default(uuid())
  orderCode    String       @unique @map("order_code") @db.VarChar(20)
  customerId   String       @map("customer_id")
  createdById  String       @map("created_by")
  deliveryType DeliveryType @map("delivery_type")
  status       OrderStatus  @default(RECIBIDO)
  subtotal     Decimal      @db.Decimal(10, 2)
  total        Decimal      @db.Decimal(10, 2)
  notes        String?      @db.VarChar(500)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  customer      User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  createdBy     User                 @relation("CreatedByOrders", fields: [createdById], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  notifications Notification[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([orderCode])
  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String  @map("order_id")
  productId           String  @map("product_id")
  productNameSnapshot String  @map("product_name_snapshot") @db.VarChar(200)
  quantity            Int
  unitPrice           Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal           Decimal @map("line_total") @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id             String      @id @default(uuid())
  orderId        String      @map("order_id")
  previousStatus OrderStatus? @map("previous_status")
  newStatus      OrderStatus @map("new_status")
  changedById    String      @map("changed_by")
  changedAt      DateTime    @default(now()) @map("changed_at")
  notes          String?     @db.VarChar(500)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User  @relation(fields: [changedById], references: [id])

  @@index([orderId])
  @@index([changedAt])
  @@map("order_status_history")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  orderId   String?          @map("order_id")
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String           @db.VarChar(1000)
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
  @@map("notifications")
}

// Tabla auxiliar para el patrón Outbox (publicación confiable de eventos)
model OutboxEvent {
  id          String   @id @default(uuid())
  eventType   String   @map("event_type") @db.VarChar(100)
  payload     Json
  published   Boolean  @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  retries     Int      @default(0)
  lastError   String?  @map("last_error") @db.VarChar(500)

  @@index([published, createdAt])
  @@map("outbox_events")
}

