# ============================================================
# OrderTrack — Variables de entorno de ejemplo
# Copiar a .env y reemplazar los valores antes de iniciar
# NUNCA incluir valores reales en este archivo
# ============================================================

# ── Base de datos PostgreSQL ─────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ordertrack
POSTGRES_USER=ordertrack_user
POSTGRES_PASSWORD=cambia_esta_password

# URL completa de conexión (usada por Prisma)
DATABASE_URL=postgresql://ordertrack_user:cambia_esta_password@localhost:5432/ordertrack

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=cambia_este_secreto_jwt_muy_largo_y_aleatorio
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=cambia_este_secreto_refresh_diferente
JWT_REFRESH_EXPIRES_IN=7d

# ── Servicio de pedidos ──────────────────────────────────────
ORDERS_SERVICE_PORT=3001
ORDERS_SERVICE_URL=http://localhost:3001

# ── Servicio de tiempo real ──────────────────────────────────
REALTIME_SERVICE_PORT=3002
REALTIME_SERVICE_URL=http://localhost:3002

# ── Servicio de notificaciones ───────────────────────────────
NOTIFICATIONS_SERVICE_PORT=3003
NOTIFICATIONS_SERVICE_URL=http://localhost:3003

# ── Servicio de reportes ─────────────────────────────────────
REPORTS_SERVICE_PORT=3004
REPORTS_SERVICE_URL=http://localhost:3004

# ── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_URL=amqp://ordertrack_user:cambia_esta_password@localhost:5672
RABBITMQ_USER=ordertrack_user
RABBITMQ_PASSWORD=cambia_esta_password

# ── Frontend Angular ─────────────────────────────────────────
FRONTEND_PORT=4200
FRONTEND_URL=http://localhost:4200

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200

# ── Entorno ──────────────────────────────────────────────────
NODE_ENV=development

# ── Credenciales de demostración (SOLO entorno local) ────────
# admin@ordertrack.pe  / Admin123!
# cocina@ordertrack.pe / Cocina123!
# atencion@ordertrack.pe / Atencion123!
# cliente1@ordertrack.pe / Cliente123!

